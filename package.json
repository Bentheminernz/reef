{
	"name": "coralsvelte",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:reencrypt": "tsx --tsconfig scripts/tsconfig.json scripts/reencrypt-db.ts",
		"script": "tsx --tsconfig scripts/tsconfig.json",
		"worker": "tsx --tsconfig scripts/tsconfig.json scripts/presence-sync.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/dotenv": "^6.1.1",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^1.47.0",
		"@sentry/sveltekit": "^11.6.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.2",
		"@types/debug": "^4.1.13",
		"daisyui": "^5.7.17",
		"debug": "^4.4.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.9",
		"lottie-web": "^5.13.0",
		"marked": "^18.0.13",
		"nxapi": "^1.6.1-next.257",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.5",
		"splatnet3-types": "^0.2.20231119210145",
		"tsx": "^4.23.13",
		"tweetnacl": "^1.0.3"
	}
}
